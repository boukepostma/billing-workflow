# Copy to .env for local development only. Never commit real values.
# Local worker authentication (the managed deployment gets a service-account
# token injected by the platform, so this is only needed for `mistral dev`).
MISTRAL_API_KEY=

# Path to the billing configuration file. Defaults to <repo>/config/billing.yaml.
# CONFIG_PATH=config/billing.yaml

# The values below are provided as WORKSPACE SECRETS in Mistral Studio and bound
# to the managed deployment as environment variables. For local runs you may
# export them in .env, but never commit them.
# SMTP_HOST=smtp.protonmail.ch
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# EBOEKHOUDEN_API_TOKEN=
# IMAP_HOST=127.0.0.1
# IMAP_PORT=1143
# IMAP_USER=
# IMAP_PASSWORD=
